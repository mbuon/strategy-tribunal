{
  "protocol_version": "1.0",
  "routing": {
    "default_provider": "chat",
    "roles": {},
    "opencode": {
      "enabled": false,
      "binary": "opencode",
      "agent": "council-member",
      "config_dir": "adapters/opencode",
      "timeout_seconds": 300,
      "retries": 1,
      "fallback": "chat",
      "default_model": "claude-agent/haiku",
      "model_fallbacks": {}
    },
    "validation_fallbacks": [
      "openai/gpt-6.2-sol",
      "muse-code/muse-spark-1.3-contributor"
    ]
  },
  "judge": {
    "jury_size": 1,
    "materiality_threshold": 0.5,
    "promotion_margin": 0.0,
    "unverified_gate_policy": "penalty",
    "unverified_gate_penalty": 1.0,
    "pairwise_tiebreak": true
  },
  "lenses": {
    "selection": "auto",
    "min": 3,
    "max": 5
  },
  "review": {
    "panel_size": 2
  },
  "limits": {
    "min_rounds": 2,
    "max_rounds": 4,
    "stable_rounds_required": 2,
    "max_model_calls": 60,
    "max_tokens_estimate": 400000,
    "max_elapsed_seconds": 1800,
    "finalisation_reserve_calls": 3,
    "max_verification_calls": 3,
    "max_reopens": 1,
    "max_leader_challenges": 1
  }
}
